      "source": [
        "with gr.Blocks() as application:\n",
        "\n",
        "    gr.Markdown(\n",
        "        \"\"\"\n",
        "        # ☁️ Cloud-Based Generative AI Application\n",
        "\n",
        "        Enter a prompt to generate content using a\n",
        "        cloud-hosted Large Language Model.\n",
        "\n",
        "        The application also evaluates the generated response\n",
        "        using response time, word count, character count,\n",
        "        and keyword relevance.\n",
        "        \"\"\"\n",
        "    )\n",
        "\n",
        "    with gr.Row():\n",
        "\n",
        "        # Left column\n",
        "        with gr.Column():\n",
        "\n",
        "            prompt_input = gr.Textbox(\n",
        "                label=\"Enter Prompt\",\n",
        "                placeholder=(\n",
        "                    \"Example: Explain the applications of \"\n",
        "                    \"Generative AI in education.\"\n",
        "                ),\n",
        "                lines=6\n",
        "            )\n",
        "\n",
        "            temperature_input = gr.Slider(\n",
        "                minimum=0.0,\n",
        "                maximum=1.0,\n",
        "                value=0.3,\n",
        "                step=0.1,\n",
        "                label=\"Temperature\"\n",
        "            )\n",
        "\n",
        "            max_tokens_input = gr.Slider(\n",
        "                minimum=50,\n",
        "                maximum=500,\n",
        "                value=250,\n",
        "                step=50,\n",
        "                label=\"Maximum Tokens\"\n",
        "            )\n",
        "\n",
        "            generate_button = gr.Button(\n",
        "                \"🚀 Generate and Evaluate\"\n",
        "            )\n",
        "\n",
        "            clear_button = gr.ClearButton(\n",
        "                [prompt_input]\n",
        "            )\n",
        "\n",
        "        # Right column\n",
        "        with gr.Column():\n",
        "\n",
        "            response_output = gr.Textbox(\n",
        "                label=\"Generated Response\",\n",
        "                lines=14\n",
        "            )\n",
        "\n",
        "            evaluation_output = gr.JSON(\n",
        "                label=\"Evaluation Metrics\"\n",
        "            )\n",
        "\n",
        "    # Connect button to function\n",
        "    generate_button.click(\n",
        "        fn=generate_and_evaluate,\n",
        "        inputs=[\n",
        "            prompt_input,\n",
        "            temperature_input,\n",
        "            max_tokens_input\n",
        "        ],\n",
        "        outputs=[\n",
        "            response_output,\n",
        "            evaluation_output\n",
        "        ]\n",
        "    )\n",
        "\n",
        "print(\"Gradio application created successfully!\")"
      ],
